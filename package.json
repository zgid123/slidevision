{
  "name": "slidevision",
  "version": "0.0.1",
  "description": "Slidev decks in one monorepo, plus a desktop app that presents them on two screens",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "update-packages": "pnpm update -i -r --latest",
    "clear": "pnpm -r exec rimraf node_modules dist .turbo lib && pnpm rimraf node_modules .turbo",
    "build": "turbo run build",
    "test": "turbo run test",
    "version-packages": "changeset version && node scripts/sync-version.ts",
    "release": "pnpm build && changeset publish",
    "set-release": "changeset",
    "tf-bootstrap": "make -C infrastructures/terraform bootstrap",
    "desktop": "turbo run build --filter=@slidevision/workspace && pnpm --filter @slidevision/desktop tauri dev"
  },
  "keywords": [
    "slidev",
    "monorepo",
    "tauri",
    "presentation"
  ],
  "author": "Alpha",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@alphacifer/biome": "^0.0.12",
    "@alphacifer/lefthook": "^0.0.2",
    "@alphacifer/tsconfig": "^0.0.16",
    "@biomejs/biome": "2.5.15",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@faker-js/faker": "10.6.0",
    "@slidev/cli": "53.1.0",
    "@slidevision/workspace": "workspace:*",
    "@types/node": "26.6.5",
    "fishery": "2.4.0",
    "lefthook": "2.2.1",
    "playwright": "1.65.1",
    "rimraf": "6.1.3",
    "tsdown": "0.23.7",
    "turbo": "2.11.7",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
