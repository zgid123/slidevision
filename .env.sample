# Copy to .env and fill in. The Terraform Makefile loads it by itself.

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

TF_VAR_cf_account_id=$CLOUDFLARE_ACCOUNT_ID

# R2 access key for the slidevision-terraform bucket, where Terraform keeps its state.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=https://$CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com
