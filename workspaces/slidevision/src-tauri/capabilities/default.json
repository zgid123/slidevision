{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the main window may do",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "allow-open-project",
    "allow-close-project",
    "allow-recent-projects",
    "allow-remove-recent-project",
    "allow-start-deck",
    "allow-play"
  ]
}
