  "keywords": [
    "slidev",
    "slidevision",
    "presentation",
    "workspace"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Alpha",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zgid123/slidevision.git",
